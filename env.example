# ==================================================
# PAC - Program and Code | Variáveis de Ambiente
# ==================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do arquivo .env.local no Git.

# --------------------------------------------------
# SUPABASE
# Encontre em: https://supabase.com/dashboard → Settings → API
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Chave secreta — use APENAS no servidor (sem o prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --------------------------------------------------
# JUDGE0 via RapidAPI
# Encontre em: https://rapidapi.com/judge0-official/api/judge0-ce
# --------------------------------------------------
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=sua_rapidapi_key_aqui
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# --------------------------------------------------
# APP
# --------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PAC
